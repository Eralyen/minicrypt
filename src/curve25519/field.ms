minicrypt.Field25519.invert = function(w, i)
    sq = @minicrypt.Field25519.square
    mul = @minicrypt.Field25519.mul
    b = i[0:16]
    sq(w, b)
    mul(w, w, b)
    for a in range(252, 0)
        sq(w, w)
        if a != 2 and a != 4 then mul(w, w, b)
    end for
end function

